import numpy as np
class Fibonacci:
    def __init__(self, n):
        self.n = n
        self.series = np.zeros(n, dtype=int)

    def generate_series(self):
        if self.n > 0:
            self.series[0] = 0
        if self.n > 1:
            self.series[1] = 1

        for i in range(2, self.n):
            self.series[i] = self.series[i-1] + self.series[i-2]

        return self.series

def main():
    user_input = input("Enter number of terms: ")
    try:
        n = int(user_input)
        if n < 0:
            print("Enter a non-negative number")
            return
    except ValueError:
        print("Enter a valid integer")
        return

    fib = Fibonacci(n)
    fib_series = fib.generate_series()
    print("Fibonacci series is", fib_series)

if __name__ == "__main__":
    main()
