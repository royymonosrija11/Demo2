class NumberToWordsConverter:
    def __init__(self):
        self.one = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
                    "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen",
                    "eighteen", "nineteen"]
        self.tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]

    def num_to_word(self, n, s):
        """
        Converts a number less than 100 to words and appends a suffix.
        """
        result = ""
        if n > 19:
            result += self.tens[n // 10] + self.one[n % 10]
        else:
            result += self.one[n]
        if n != 0:
            result += s
        return result

    def convert_to_words(self, n):
        """
        Converts a whole number into words.
        """
        result = ""
        result += self.num_to_word(n // 10000000, "crore ")
        result += self.num_to_word((n // 100000) % 100, "lakh ")
        result += self.num_to_word((n // 1000) % 100, "thousand ")
        result += self.num_to_word((n // 100) % 10, "hundred ")
        if n > 100 and n % 100 > 0:
            result += "and "
        result += self.num_to_word(n % 100, "")
        return result

def main():
    converter = NumberToWordsConverter()
    user_input = input("Enter a number: ")
    try:
        number = int(user_input)
    except ValueError:
        print("Invalid input. Please enter an integer.")
        return

    print(converter.convert_to_words(number))

if __name__ == "__main__":
    main()
